; Engine configuration file.
; artificer-pipeline — Godot 프로젝트 (Phase 2, play 트랙 인프라)
;
; 이 파일은 에디터 UI로 편집하는 것이 원칙이나, 파이프라인 초기화 단계에서는
; 최소 설정만 수기로 둔다. 게임 제목은 아직 미정이므로 config/name 은
; 저장소 이름 기준의 중립값을 사용한다 (HANDOFF §2: 검증 대상 게임은
; 로그라이크/픽셀아트지만 파이프라인·프로젝트에는 하드코딩하지 않는다).
;
; Godot 4.6.x 고정 (CLAUDE.md 코딩 규칙). config_version=5 는 Godot 4.x 형식.
; 메인 씬(main_scene)은 중립 빈 씬(scenes/main.tscn)이며, 승인된 spec 을 받아
; play build 가 채운다. 로그라이크 데모의 [input] 이동 액션은 제거되어
; pipeline/tests/fixtures/sample_game/ 픽스처로만 남는다.

config_version=5

[application]

config/name="artificer-pipeline"
config/description="AI 오케스트레이션 파이프라인 검증용 Godot 프로젝트. 게임 제목 미정."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")

[debug]

gdscript/warnings/untyped_declaration=1

[rendering]

; 웹(HTML5) export 제약: Godot 4.6 의 웹 플랫폼은 Compatibility 렌더러(WebGL 2)만
; 안정 지원한다. forward_plus(기본값)로 두면 웹 빌드가 성립하지 않으므로 고정한다.
; 셰이더(CRT 스캔라인·글로우·색수차)도 이 렌더러 기준으로 작성한다. (0-b 실측 근거:
; docs/web-export.md)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[gui]

; 웹 export 에는 시스템 폰트 폴백이 없어 Godot 기본 폰트(한글 미포함)가 그대로 쓰인다
; → 한글 전면 두부(□). 로컬 에디터는 macOS 시스템 폴백으로 가려져 있던 문제.
; Neo둥근모(OFL-1.1, 0.62MB)를 기본 폰트로 번들한다 — CRT 터미널 미학과 정합.
; 픽셀 폰트이므로 안티앨리어싱 off. 실측 기록: docs/web-export.md
theme/custom_font="res://assets/fonts/neodgm.ttf"
theme/default_font_antialiasing=0

[display]

; 1턴 슬라이스 디자인 해상도(16:9) + 스트레치. 배경 3:2는 이후 16:9 재작업(웹 export 정합).
; spec: docs/specs/turn_loop_vertical_slice.md
window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

