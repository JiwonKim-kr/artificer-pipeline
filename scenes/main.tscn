[gd_scene load_steps=2 format=3]

; 「태엽 인간」 1턴 수직 슬라이스 진입 씬. 루트 Main(Control)에 src/ui/main.gd 가
; 데스크→모니터 클릭→CRT OS UI 를 구성한다. spec: docs/specs/turn_loop_vertical_slice.md

[ext_resource type="Script" path="res://src/ui/main.gd" id="1_main"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")
